# Copiar como .env.production. Nunca subir ese archivo ni sus claves al repositorio.
POSTGRES_USER=motosafe
POSTGRES_PASSWORD=CAMBIAR_POR_SECRETO_LARGO_Y_UNICO
POSTGRES_DB=motosafe_gba
DATABASE_URL=postgresql://motosafe:CAMBIAR_POR_SECRETO_LARGO_Y_UNICO@db:5432/motosafe_gba

# Dominio público del frontend. En Docker Compose con el proxy /api basta este
# origen; agregar otros sólo si hay dominios de preview deliberados.
CORS_ALLOWED_ORIGINS=https://app.tu-dominio.example
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
TOMTOM_API_KEY=REEMPLAZAR_POR_LA_CLAVE_DE_PRODUCCION

# Frecuencia conservadora para no sobrecargar a las fuentes. Ajustar sólo tras
# medir calidad, duración y condiciones de uso de cada fuente.
SCRAPER_INTERVAL_MINUTES=180
MOTOSAFE_WEB_PORT=8080
