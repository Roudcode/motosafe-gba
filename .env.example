DATABASE_URL=postgresql://motosafe:motosafe_dev@localhost:5432/motosafe_gba
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
TOMTOM_API_KEY=tu_key_de_tomtom_aca
# Origenes permitidos por CORS, separados por coma (sin espacios extra). En
# deploy real, poner el dominio publico del frontend.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# --- Acceso remoto via Tailscale Funnel (publicar la app en internet) ------
# Generar AUTH_USERNAME y AUTH_PASSWORD_HASH corriendo, parado en backend/:
#   python generar_password.py
# Generar SESSION_SECRET con:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Login activado por defecto (acceso por Funnel). Solo un despliegue publico
# sin login usa AUTH_HABILITADO=false; ahi las tres variables de abajo sobran.
AUTH_HABILITADO=true
AUTH_USERNAME=
AUTH_PASSWORD_HASH=
SESSION_SECRET=
# Horas que dura la sesion antes de pedir login de nuevo (default: 12)
SESSION_MAX_AGE_HOURS=12
# URL publica fija que entrega "tailscale funnel status" (la pone
# iniciar_funnel.bat automaticamente en tailscale/public_url.txt; esta
# variable es para cuando el backend necesite construir un link absoluto,
# por ejemplo en una notificacion).
PUBLIC_URL=
